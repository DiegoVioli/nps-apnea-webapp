# Copia questo file in .env e personalizza i valori.
# Non committare mai file .env reali nel repository.
# Per la produzione usa valori dedicati e un secret manager, non questo esempio.

SECRET_KEY=dev-only-change-this-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

# In produzione HSTS e HTTPS redirect si attivano con DEBUG=False.
# Usa USE_X_FORWARDED_PROTO=True solo dietro un reverse proxy fidato.
USE_X_FORWARDED_PROTO=False

# Database (opzionale: usa il default SQLite locale se lasciato vuoto)
# DATABASE_URL=sqlite:///db.sqlite3

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# API promemoria certificati
CERTIFICATI_API_TOKEN=change-this-random-token

# Documenti consenso
CONSENSO_REGOLAMENTO_URL=
CONSENSO_REGOLAMENTO_VERSIONE=PROVVISORIA
CONSENSO_PRIVACY_URL=
CONSENSO_PRIVACY_VERSIONE=PROVVISORIA
CONSENSO_FOTO_VIDEO_URL=
CONSENSO_FOTO_VIDEO_VERSIONE=PROVVISORIA
